.pxdiff/
config.php

# Local Graphify runtime; keep the graph, report, HTML and durable lessons.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html
!graphify-out/memory/
!graphify-out/memory/*.md
!graphify-out/reflections/
!graphify-out/reflections/LESSONS.md

# Obsidian machine-local workspace state.
.obsidian/workspace*.json
.obsidian/cache/
